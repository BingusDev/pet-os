# JACK IN: let the PET-os app switch the USB port to device mode and back,
# and set the clock (the PET has no battery clock) from a trusted PC or RomM.
# Install on the PET (as root), replacing "pet" with the user APPLaunch runs the app as:
#   install -m 0440 pet-os-jackin.sudoers /etc/sudoers.d/pet-os-jackin && visudo -c
pet ALL=(root) NOPASSWD: /usr/libexec/pet-os/usb-gadget.sh up, /usr/libexec/pet-os/usb-gadget.sh down, /usr/libexec/pet-os/usb-gadget.sh status
pet ALL=(root) NOPASSWD: /usr/libexec/pet-os/set-clock.sh [0-9]*
